                    "*": "deny",
                    "grep*": "allow",
                    "rg*": "allow",
                    "php artisan test*": "allow",
                    "php artisan route:list*": "allow",
                    "php artisan make:*": "allow",
                    "php artisan view:clear*": "allow",
                    "php scripts/*": "allow",
                    "vendor/bin/pint --dirty*": "allow",
                    "php artisan migrate*": "deny",
                    "rm *": "deny"
                }
            }
        },
