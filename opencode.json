{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "team-lead",
    "subagent_depth": 2,
    "instructions": [
        "AGENTS.md",
        ".ai/guidelines/00-reglas.md",
        ".ai/guidelines/07-no-romper.md",
        ".ai/guidelines/10-impacto.md"
    ],
    "permission": {
        "bash": {
            "*": "ask",
            "git push*": "deny",
            "git reset --hard*": "deny",
            "git checkout .*": "deny",
            "git clean*": "deny",
            "rm -rf*": "deny",
            "composer update*": "deny",
            "php artisan migrate:fresh*": "deny",
            "php artisan migrate:reset*": "deny",
            "php artisan migrate:rollback*": "deny",
            "php artisan db:wipe*": "deny"
        }
    },
    "agent": {
        "team-lead": {
            "model": "opencode/big-pickle",
            "permission": {
                "read": "allow",
                "edit": {
                    "*": "deny",
                    ".ui-work/**": "allow",
                    "docs/**": "allow"
                },
                "bash": {
                    "*": "ask",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git log*": "allow",
                    "php artisan route:list*": "allow",
                    "php scripts/*": "allow"
                }
            }
        },
        "decisiones": {
            "model": "opencode/big-pickle",
            "permission": {
                "read": "allow",
                "edit": {
                    "*": "deny",
                    ".ui-work/02-decisiones/**": "allow",
                    "docs/DECISIONES.md": "allow"
                },
                "bash": {
                    "*": "deny",
                    "grep*": "allow",
                    "rg*": "allow",
                    "git log*": "allow",
                    "php artisan route:list*": "allow"
                }
            }
        },
        "auditor": {
            "model": "opencode/nemotron-3.5-lightning-free",
            "permission": {
                "read": "allow",
                "edit": {
                    "*": "deny",
                    ".ui-work/00-auditoria/**": "allow"
                },
                "bash": {
                    "*": "deny",
                    "grep*": "allow",
                    "rg*": "allow",
                    "php artisan route:list*": "allow",
                    "php scripts/verificar_referencias.php*": "allow",
                    "php scripts/impacto.php*": "allow"
